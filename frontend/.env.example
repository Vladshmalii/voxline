# Backend API host: {VITE_API_URL}/api/v1/... (REST + WS playground).
# Unset -> http://localhost:8086. Set to an empty string for same-origin
# requests (production behind the nginx /api proxy).
VITE_API_URL=http://localhost:8086

# Dev only: where the Vite dev server forwards /api when VITE_API_URL="".
# VITE_DEV_PROXY_TARGET=http://localhost:8086
