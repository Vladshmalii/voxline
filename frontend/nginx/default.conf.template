# Rendered by the nginx image's entrypoint (envsubst) into conf.d/default.conf.
# API_UPSTREAM: where /api is proxied, e.g. http://backend:8086
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Backend API (REST + the agent playground WebSocket). Build the app with
  # VITE_API_URL="" so the browser talks to this origin.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    client_max_body_size 50m;
  }

  # Security headers for the app shell. The CSP allows what the bundle needs:
  # its own scripts, inline styles (styled-components), and same-origin API/WS.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: https:; connect-src 'self' ws: wss:; frame-ancestors 'none'" always;

  location / {
    try_files $uri $uri/ /index.html;
  }
}
