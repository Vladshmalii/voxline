# Rendered by the nginx image's entrypoint (envsubst) into conf.d/default.conf.
# API_UPSTREAM: where /api is proxied, e.g. http://backend:8086
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Backend API (REST + the agent playground WebSocket). Build the app with
  # VITE_API_URL="" so the browser talks to this origin.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    client_max_body_size 50m;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
