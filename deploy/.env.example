# Production .env for $DEPLOY_PATH/.env on the server (NOT in git).
# Shared by every backend container; compose also reads it for ${...}.
# Full list of backend settings: backend/.env.example.

# -- Compose ---------------------------------------------------------------------
# GHCR namespace, lowercase (github.com/Vladshmalii -> vladshmalii).
IMAGE_OWNER=vladshmalii
# Pin a commit sha to roll back, e.g. BACKEND_TAG=sha-<full commit sha>; default latest.
# BACKEND_TAG=latest
# FRONTEND_TAG=latest
# LANDING_TAG=latest

# -- Application -----------------------------------------------------------------
SECRET_KEY=generate-with-openssl-rand-hex-32
SERVICE_PREFIX=call
APP_WORKERS_NUM=2
LOG_LEVEL=INFO
APPLICATION_STATE=production
# The admin calls /api same-origin (via its nginx); the landing posts leads
# cross-origin, so it has to be listed here.
ORIGINS=https://voxline.dvms.tech https://voxline-admin.dvms.tech

# -- Database --------------------------------------------------------------------
DB__HOST=postgres
DB__PORT=5432
DB__USER=voxline
DB__PASSWORD=generate-a-strong-password
DB__PREFIX=org_
DB__CONTROL_NAME=voxline_control
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__POOL_TIMEOUT=30
DB__POOL_RECYCLE=1800
DB__POOL_PRE_PING=true

# -- Redis -----------------------------------------------------------------------
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__TYPE=standalone
REDIS__PASSWORD=generate-a-strong-password

# -- Auth ------------------------------------------------------------------------
JWT__SECRET=
JWT__ACCESS_TTL_SECONDS=900
JWT__REFRESH_TTL_DAYS=30
JWT__COOKIE_SAMESITE=lax

# -- First-run bootstrap (idempotent; remove the password after first deploy) ----
BOOTSTRAP_EMAIL=admin@dvms.tech
BOOTSTRAP_PASSWORD=change-me-now
BOOTSTRAP_ORG_NAME=Default

# -- Call worker -----------------------------------------------------------------
# Public base of the hooks service: Traefik strips /hooks, the app is served
# under /api (root_path), so callbacks land on /api/v1/media/... inside hooks.
CALL_WORKER__MEDIA_URL=wss://voxline-backend.dvms.tech/hooks/api/v1
CALL_WORKER__MAX_CONCURRENT_CALLS=10
CALL_WORKER__DIAL_TIMEOUT_SECONDS=60
