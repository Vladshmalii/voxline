# -- Application ---------------------------------------------------------------
# Signs the session cookie and the call/SMS callback tokens. The JWT signing key
# is derived from it unless JWT__SECRET is set. Use a long random value.
SECRET_KEY=change-me-to-a-random-secret
# Postgres schema inside each organization database (and Redis key namespace).
SERVICE_PREFIX=call
APP_WORKERS_NUM=1
LOG_LEVEL=INFO
# development | production | testing
APPLICATION_STATE=development
# space-separated list of allowed origins, or * for all
ORIGINS=http://localhost:3000 http://localhost:8080

# -- Database (PostgreSQL) -------------------------------------------------------
# One control database (users, organizations, memberships, refresh tokens) plus
# one database per organization, named {DB__PREFIX}{organization_uuid}.
DB__HOST=postgres
DB__PORT=5432
DB__USER=postgres
DB__PASSWORD=postgres
DB__PREFIX=org_
DB__CONTROL_NAME=voxline_control
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20
DB__POOL_TIMEOUT=30
DB__POOL_RECYCLE=1800
DB__POOL_PRE_PING=true

# -- Redis -----------------------------------------------------------------------
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__TYPE=standalone
REDIS__PASSWORD=redis
# For Sentinel replace HOST/PORT/TYPE above with:
# REDIS__TYPE=sentinel
# REDIS__SENTINELS=[["redis-sentinel-0",26379],["redis-sentinel-1",26379],["redis-sentinel-2",26379]]
# REDIS__SERVICE_NAME=mymaster

# -- Auth ------------------------------------------------------------------------
# HS256 key for access tokens. Empty = derived from SECRET_KEY.
JWT__SECRET=
# Access token lifetime (the refresh token lives JWT__REFRESH_TTL_DAYS days).
JWT__ACCESS_TTL_SECONDS=900
JWT__REFRESH_TTL_DAYS=30
# Unset = Secure cookies in production only. lax | strict | none
# JWT__COOKIE_SECURE=true
JWT__COOKIE_SAMESITE=lax
# JWT__COOKIE_DOMAIN=example.com

# -- First-run bootstrap (docker compose `migrate` service / python -m src.bootstrap)
# Creates the first superuser and organization when set. Idempotent.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change-me-now
BOOTSTRAP_ORG_NAME=Default

# -- Call worker -----------------------------------------------------------------
# Leave the whole CALL_WORKER__ block commented out on the HTTP process.
CALL_WORKER__MEDIA_URL=wss://media.example.com
CALL_WORKER__MAX_CONCURRENT_CALLS=10
CALL_WORKER__DIAL_TIMEOUT_SECONDS=60
